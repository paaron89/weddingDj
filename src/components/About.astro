---
import { Image } from "astro:assets";
import SectionHead from "./SectionHead.astro";
import { business, photos, stats } from "../data/site";
---

<section class="section" id="about">
  <div class="container about">
    <div class="about-media">
      <div class="arch-frame">
        <Image
          src={photos.about.src}
          alt={photos.about.alt}
          widths={[400, 700, 1000]}
          sizes="(max-width: 900px) 80vw, 440px"
        />
      </div>
    </div>
    <div class="about-text">
      <SectionHead eyebrow="about me" title={`Hi, I'm ${business.djName}`} align="left" />
      <p>I've played more than 300 weddings over the last 12 years, from barn weddings for 40 guests to ballroom receptions for 300. My style is simple: I learn what you love and what gets your families dancing, then I blend the two all night.</p>
      <p>Before your day we'll plan your timeline together, build your must-play and do-not-play lists, and I'll coordinate with your venue and planner so you don't have to.</p>
      <p class="script signature">{business.djName}</p>
      <ul class="stats">
        {stats.map((stat) => <li><strong>{stat.value}</strong><span>{stat.label}</span></li>)}
      </ul>
    </div>
  </div>
</section>
