---
import { Image } from "astro:assets";
import SectionHead from "./SectionHead.astro";
import { business, images } from "../data/site";
import { useContent } from "../i18n";

const { about } = useContent(Astro.currentLocale);
---

<section class="section" id="about">
  <div class="container about">
    <div class="about-media">
      <div class="arch-frame">
        <Image
          src={images.about}
          alt={about.imageAlt}
          widths={[400, 700, 1000]}
          sizes="(max-width: 900px) 80vw, 440px"
        />
      </div>
    </div>
    <div class="about-text">
      <SectionHead eyebrow={about.eyebrow} title={about.title} align="left" />
      {about.paragraphs.map((text) => <p>{text}</p>)}
      <p class="script signature">{business.djName}</p>
      <ul class="stats">
        {about.stats.map((stat) => <li><strong>{stat.value}</strong><span>{stat.label}</span></li>)}
      </ul>
    </div>
  </div>
</section>
