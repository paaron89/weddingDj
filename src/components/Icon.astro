---
// Thin line icons used on the service cards.
interface Props {
  name: "rings" | "glasses" | "music" | "mic" | "sparkle" | "calendar";
}

const { name } = Astro.props;
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  width="28"
  height="28"
  fill="none"
  stroke="currentColor"
  stroke-width="1.3"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === "rings" && (
    <>
      <circle cx="9" cy="14.5" r="5.5" />
      <circle cx="15" cy="14.5" r="5.5" />
      <path d="M15 3.5l1.8 1.8L15 7.1l-1.8-1.8z" />
    </>
  )}
  {name === "glasses" && (
    <>
      <path d="M5.5 3h4l-.6 6.4a1.4 1.4 0 0 1-2.8 0z" />
      <path d="M7.5 11v7.5M5.5 20.5h4" />
      <path d="M14.5 3h4l-.6 6.4a1.4 1.4 0 0 1-2.8 0z" />
      <path d="M16.5 11v7.5M14.5 20.5h4" />
    </>
  )}
  {name === "music" && (
    <>
      <path d="M9 18V5.5l11-2V16" />
      <circle cx="6" cy="18" r="3" />
      <circle cx="17" cy="16" r="3" />
    </>
  )}
  {name === "mic" && (
    <>
      <rect x="9" y="2.5" width="6" height="11.5" rx="3" />
      <path d="M5.5 10.5v.5a6.5 6.5 0 0 0 13 0v-.5M12 17.5v4M8.5 21.5h7" />
    </>
  )}
  {name === "sparkle" && (
    <>
      <path d="M11 4l1.7 5.3L18 11l-5.3 1.7L11 18l-1.7-5.3L4 11l5.3-1.7z" />
      <path d="M19 2.5v4M17 4.5h4M5 17.5v3M3.5 19h3" />
    </>
  )}
  {name === "calendar" && (
    <>
      <rect x="3" y="5" width="18" height="16" rx="2" />
      <path d="M3 10h18M8 3v4M16 3v4" />
      <path d="M12 18s-2.8-1.7-2.8-3.4a1.4 1.4 0 0 1 2.8-.3 1.4 1.4 0 0 1 2.8.3c0 1.7-2.8 3.4-2.8 3.4z" />
    </>
  )}
</svg>
