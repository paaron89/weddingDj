---
import SectionHead from "./SectionHead.astro";
import { useContent } from "../i18n";

const { packages } = useContent(Astro.currentLocale);
---

<section class="section" id="packages">
  <div class="container">
    <SectionHead eyebrow={packages.eyebrow} title={packages.title}>
      <p>{packages.lead}</p>
    </SectionHead>
    <div class="grid grid-3 packages">
      {packages.items.map((pkg) => (
        <article class:list={["package", { featured: pkg.featured }]}>
          {pkg.featured && <p class="badge">{packages.badge}</p>}
          <h3>{pkg.name}</h3>
          <p class="price">{pkg.price}</p>
          <ul>
            {pkg.features.map((feature) => <li>{feature}</li>)}
          </ul>
          <a
            href="#contact"
            class:list={["btn", { "btn-outline": !pkg.featured }]}
            data-package={pkg.name}
          >
            {packages.cta}
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
