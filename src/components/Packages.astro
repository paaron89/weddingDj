---
import SectionHead from "./SectionHead.astro";
import { packages } from "../data/site";
---

<section class="section" id="packages">
  <div class="container">
    <SectionHead eyebrow="Packages" title="Simple, all-inclusive pricing">
      <p>All packages include professional sound, backup equipment, travel within 50 miles and full planning.</p>
    </SectionHead>
    <div class="grid grid-3 packages">
      {packages.map((pkg) => (
        <article class:list={["package", { featured: pkg.featured }]}>
          {pkg.featured && <p class="badge">Most popular</p>}
          <h3>{pkg.name}</h3>
          <p class="price">{pkg.price}</p>
          <ul>
            {pkg.features.map((feature) => <li>{feature}</li>)}
          </ul>
          <a
            href="#contact"
            class:list={["btn", { "btn-outline": !pkg.featured }]}
            data-package={pkg.name}
          >
            Enquire
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
