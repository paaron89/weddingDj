---
import { Image } from "astro:assets";
import SectionHead from "./SectionHead.astro";
import { images } from "../data/site";
import { useContent } from "../i18n";

const { testimonials } = useContent(Astro.currentLocale);
---

<section class="section section-photo" id="testimonials">
  <Image
    src={images.testimonials}
    alt=""
    class="section-photo-bg"
    widths={[800, 1400, 2000]}
    sizes="100vw"
  />
  <div class="container">
    <SectionHead eyebrow={testimonials.eyebrow} title={testimonials.title} />
    <div class="grid grid-3">
      {testimonials.items.map((t) => (
        <blockquote class="quote">
          <span class="quote-mark" aria-hidden="true">&ldquo;</span>
          <p>{t.quote}</p>
          <footer>
            <span class="script">{t.couple}</span>
            <small>{t.date}</small>
          </footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>
