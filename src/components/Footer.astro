---
import { business } from "../data/site";
---

<footer class="site-footer">
  <div class="container footer-inner">
    <a href="#top" class="logo logo-light">
      <span class="logo-script">{business.name}</span>
      <span class="logo-caps">{business.nameAccent}</span>
    </a>
    <p class="footer-tagline">Wedding DJ &amp; MC · {business.location}</p>
    <p class="footer-small">
      &copy; <span id="year">{new Date().getFullYear()}</span> {business.name} {business.nameAccent}. Sample site
      {" · "}Photos from <a href="https://unsplash.com" rel="noopener">Unsplash</a>
      {" · "}<a href="#top">Back to top &uarr;</a>
    </p>
  </div>
</footer>

<script>
  // Keep the year current even if the site hasn't been rebuilt this year
  document.getElementById("year")!.textContent = String(new Date().getFullYear());
</script>
