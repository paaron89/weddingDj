---
import { Image } from "astro:assets";
import SectionHead from "./SectionHead.astro";
import { business, images } from "../data/site";
import { getLang, useContent } from "../i18n";

const { contact, packages } = useContent(Astro.currentLocale);
const lang = getLang(Astro.currentLocale);
const f = contact.form;
---

<section class="section section-blush contact" id="contact">
  <div class="container contact-grid">
    <div class="contact-intro">
      <SectionHead eyebrow={contact.eyebrow} title={contact.title} align="left">
        <p>{contact.lead}</p>
      </SectionHead>
      <ul class="contact-details">
        <li><strong>{contact.details.email}</strong> {business.email}</li>
        <li><strong>{contact.details.phone}</strong> {business.phone}</li>
        <li><strong>{contact.details.location}</strong> {contact.location}</li>
      </ul>
      <div class="arch-frame arch-small">
        <Image src={images.contact} alt={contact.imageAlt} widths={[300, 600]} sizes="300px" />
      </div>
    </div>

    <form
      class="form"
      id="enquiry-form"
      novalidate
      data-locale={lang}
      data-messages={JSON.stringify(contact.messages)}
    >
      <div class="form-row">
        <div class="field">
          <label for="names">{f.names}</label>
          <input id="names" name="names" type="text" placeholder={f.namesPlaceholder} required />
        </div>
        <div class="field">
          <label for="email">{f.email}</label>
          <input id="email" name="email" type="email" placeholder={f.emailPlaceholder} required />
        </div>
      </div>
      <div class="form-row">
        <div class="field">
          <label for="date">{f.date}</label>
          <input id="date" name="date" type="date" required />
        </div>
        <div class="field">
          <label for="guests">{f.guests}</label>
          <input id="guests" name="guests" type="number" min="1" placeholder="120" />
        </div>
      </div>
      <div class="form-row">
        <div class="field">
          <label for="venue">{f.venue}</label>
          <input id="venue" name="venue" type="text" placeholder={f.venuePlaceholder} />
        </div>
        <div class="field">
          <label for="package">{f.package}</label>
          <select id="package" name="package">
            <option value="">{f.packageUnsure}</option>
            {packages.items.map((pkg) => <option>{pkg.name}</option>)}
          </select>
        </div>
      </div>
      <div class="field">
        <label for="message">{f.message}</label>
        <textarea id="message" name="message" rows="4" placeholder={f.messagePlaceholder}></textarea>
      </div>
      <button type="submit" class="btn btn-block">{f.submit}</button>
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById("enquiry-form") as HTMLFormElement;
  const status = form.querySelector<HTMLElement>(".form-status")!;
  const namesInput = form.elements.namedItem("names") as HTMLInputElement;
  const emailInput = form.elements.namedItem("email") as HTMLInputElement;
  const dateInput = form.elements.namedItem("date") as HTMLInputElement;
  const packageSelect = form.elements.namedItem("package") as HTMLSelectElement;

  // Texts in the page's language, rendered into data attributes by Astro
  const locale = form.dataset.locale;
  const messages: Record<string, string> = JSON.parse(form.dataset.messages ?? "{}");

  // "Enquire" buttons on the packages pre-select that package
  document.querySelectorAll<HTMLElement>("[data-package]").forEach((btn) => {
    btn.addEventListener("click", () => {
      packageSelect.value = btn.dataset.package ?? "";
    });
  });

  // Wedding date can't be in the past (local date, not UTC)
  const today = new Date();
  dateInput.min = [
    today.getFullYear(),
    String(today.getMonth() + 1).padStart(2, "0"),
    String(today.getDate()).padStart(2, "0"),
  ].join("-");

  function setError(input: HTMLInputElement, message: string) {
    const field = input.closest(".field")!;
    let error = field.querySelector(".error");
    field.classList.toggle("invalid", Boolean(message));
    if (message) {
      if (!error) {
        error = document.createElement("span");
        error.className = "error";
        field.appendChild(error);
      }
      error.textContent = message;
    } else {
      error?.remove();
    }
  }

  function validate() {
    let valid = true;

    if (!namesInput.value.trim()) {
      setError(namesInput, messages.namesRequired);
      valid = false;
    } else {
      setError(namesInput, "");
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value.trim())) {
      setError(emailInput, messages.emailInvalid);
      valid = false;
    } else {
      setError(emailInput, "");
    }

    if (!dateInput.value) {
      setError(dateInput, messages.dateRequired);
      valid = false;
    } else if (dateInput.value < dateInput.min) {
      setError(dateInput, messages.datePast);
      valid = false;
    } else {
      setError(dateInput, "");
    }

    return valid;
  }

  form.addEventListener("input", (e) => {
    if ((e.target as Element).closest(".field.invalid")) validate();
  });

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!validate()) {
      status.textContent = "";
      form.querySelector<HTMLInputElement>(".field.invalid input")?.focus();
      return;
    }

    // Sample site: no backend. Hook this up to a form service or API later.
    const names = namesInput.value.trim();
    const date = new Date(dateInput.value + "T00:00:00").toLocaleDateString(locale, {
      day: "numeric",
      month: "long",
      year: "numeric",
    });
    status.textContent = messages.success.replace("{names}", names).replace("{date}", date);
    form.reset();
  });
</script>
