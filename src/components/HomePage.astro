---
// The whole one-page site. Rendered once per language by src/pages/.
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import About from "./About.astro";
import Services from "./Services.astro";
import Packages from "./Packages.astro";
import Gallery from "./Gallery.astro";
import Testimonials from "./Testimonials.astro";
import Faq from "./Faq.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import { useContent } from "../i18n";

const t = useContent(Astro.currentLocale);
---

<Layout title={t.meta.title} description={t.meta.description}>
  <Header />
  <main>
    <Hero />
    <About />
    <Services />
    <Packages />
    <Gallery />
    <Testimonials />
    <Faq />
    <Contact />
  </main>
  <Footer />
</Layout>
