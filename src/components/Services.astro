---
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
import { services } from "../data/site";
---

<section class="section section-blush" id="services">
  <div class="container">
    <SectionHead eyebrow="services" title="Everything your day needs to sound right" />
    <div class="grid grid-3">
      {services.map((service) => (
        <article class="card">
          <div class="card-icon"><Icon name={service.icon} /></div>
          <h3>{service.title}</h3>
          <p>{service.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
